# Documentation (exclude all by default, then whitelist runtime content files)
*.md
docs/*
!docs/about_soccer_predictor.txt
!docs/virtualsite_contact_details.txt
!docs/virtualsite_disclaimer_notice.txt

# Data files (exclude from Docker image - use volumes)
data/seasons/
data/stats/
data/*.csv
# WC2026 datasets ARE needed at runtime:
#   - wc2026_48_teams_h2h_summary_2006_2026.csv (~128 KB) backs the
#     /wc2026/model/status lazy-recompute path when the loaded BT
#     artifact predates the in-artifact metric bake-in.
#   - wc2026_48_teams_used.csv (<1 KB) is consumed by core.wc2026_train
#     to keep cold-start teams in the artifact.
!data/wc2026_*.csv

# Frontend source (served separately)
web/
node_modules/

